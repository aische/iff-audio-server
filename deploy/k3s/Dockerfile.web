# syntax=docker/dockerfile:1
# PUBLIC_BASE / VITE_* come from deploy.sh upload (site.yaml); defaults match /apppath.

FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/db/package.json packages/db/
RUN npm ci --workspace=web --include-workspace-root

COPY apps/web ./apps/web

ARG PUBLIC_BASE=/apppath
ARG VITE_BASE_PATH=/apppath/
ARG VITE_API_URL=/apppath/api
ENV VITE_BASE_PATH=$VITE_BASE_PATH \
    VITE_API_URL=$VITE_API_URL

RUN npm run build -w web

FROM nginx:1.27-alpine
ARG PUBLIC_BASE=/apppath
COPY deploy/k3s/nginx-web.conf.template /tmp/nginx-web.conf.template
RUN sed "s|@BASE_PATH@|${PUBLIC_BASE}|g" /tmp/nginx-web.conf.template \
      > /etc/nginx/conf.d/default.conf \
    && rm /tmp/nginx-web.conf.template
COPY --from=build /app/apps/web/dist /usr/share/nginx/html${PUBLIC_BASE}
EXPOSE 80
