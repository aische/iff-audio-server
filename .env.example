# Web (build-time / Vite). Local: leave as-is (proxy /api → API).
VITE_BASE_PATH=/
VITE_API_URL=/api

# API (runtime)
DATABASE_URL=postgresql://iff:iff@localhost:5432/iff
SESSION_SECRET=change-me-to-a-long-random-string

# Flat MP3 library folder. Relative paths resolve from the monorepo root.
LIBRARY_PATH=./data/library

# Local Vite origin. Leave unset for same-origin prod.
CORS_ORIGIN=http://localhost:5173

# Local: false. Behind HTTPS: true (also enables trust proxy unless TRUST_PROXY is set).
COOKIE_SECURE=false

# Optional. Defaults to true when COOKIE_SECURE=true.
# TRUST_PROXY=true
